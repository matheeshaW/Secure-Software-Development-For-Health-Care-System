# =============================================================================
# SE4030 Healthcare Microservices - Central Environment Configuration Template
# =============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this template to .env and configure environment-specific values:
# cp .env.example .env
# =============================================================================

# --- JWT Authentication & Cryptographic Key ---
# Generate a cryptographically secure 256-bit key using:
# node scripts/generate-jwt-secret.js
JWT_SECRET=your_generated_256_bit_cryptographically_secure_hex_key_here

# --- Database Credentials (MongoDB) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_database_password_here

# Service-Specific MongoDB Connection URIs
PATIENT_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/patient-service?authSource=admin
DOCTOR_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/doctor-service?authSource=admin
APPOINTMENT_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/appointment-service?authSource=admin
PAYMENT_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/payment-service?authSource=admin
NOTIFICATION_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/notification-service?authSource=admin
TELEMEDICINE_MONGO_URI=mongodb://admin:your_secure_database_password_here@mongodb:27017/telemedicine-service?authSource=admin

# --- RabbitMQ Message Broker Credentials ---
RABBITMQ_DEFAULT_USER=hms_broker_user
RABBITMQ_DEFAULT_PASS=your_secure_rabbitmq_password_here
RABBITMQ_URL=amqp://hms_broker_user:your_secure_rabbitmq_password_here@rabbitmq:5672

# --- Email Notification Service (SMTP) ---
EMAIL_USER=no-reply@yourhealthcareplatform.com
EMAIL_PASS=your_secure_smtp_app_password_here

# --- Cloudinary Medical Document Storage ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Payment Gateway (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# --- Frontend & CORS Settings ---
FRONTEND_URL=http://localhost:5173
PORT=5000
